<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_backend</name>
  <version>0.0.0</version>
  <description>L3 back-end: global keyframe factor graph (GTSAM iSAM2)</description>
  <maintainer email="dev@meridian.local">Meridian</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meridian_cmake</buildtool_depend>

  <depend>meridian_common</depend>
  <depend>meridian_config</depend>
  <depend>meridian_debug</depend>
  <depend>meridian_calib</depend>
  <depend>eigen</depend>
  <!-- GTSAM is provided by the dev image (docker/install-deps.sh) and found via
       find_package(GTSAM); it has no standard rosdep key, so it is not listed here. -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
