<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_place</name>
  <version>0.0.0</version>
  <description>L5 place recognition / loop closure: the ILoopDetector hierarchical
    cascade (Scan Context retrieval, GICP verification, single-loop consistency) and
    the retained KeyframeStore it reads geometry from. Emits LoopConstraint to L3. No ROS.</description>
  <maintainer email="william@gcp.callistodata.com">William Profit</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meridian_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>meridian_common</depend>
  <depend>meridian_config</depend>
  <depend>meridian_debug</depend>
  <depend>meridian_map</depend>
  <!-- Sophus is provided by the dev image and found via find_package(Sophus); it has no
       standard rosdep key, so it is not listed here. -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
