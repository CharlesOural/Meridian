<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_debug</name>
  <version>0.0.0</version>
  <description>Cross-cutting telemetry and logging bus: the TelemetrySink and LogSink
    interfaces, Marker/ImageOverlay/PointCloudView payload types, ScopedTimer, and the
    NullSink default. The core publishes introspection through these sinks; the ROS
    wrapper binds concrete sinks. No ROS.</description>
  <maintainer email="charles@cfglobal.fr">Charles Farhat</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meridian_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>meridian_common</depend>
  <!-- Sophus is provided by the dev image (docker/install-deps.sh) and found via
       find_package(Sophus); it has no standard rosdep key, so it is not listed here. -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
