<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_map</name>
  <version>0.0.0</version>
  <description>L4 layered map: the canonical KeyframeStore, the Tier-R registration
    voxel-hash, and the backend-pluggable ISurfaceMap surface tier (cpu host backend;
    nvblox GPU backend under MERIDIAN_MAP_NVBLOX). Loop correction is clear-and-rebuild
    from retained clouds at corrected poses. No ROS.</description>
  <maintainer email="william@gcp.callistodata.com">William Profit</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meridian_cmake</buildtool_depend>

  <depend>eigen</depend>
  <!-- Workspace-built plain-CMake package (dependencies.repos); orders the colcon graph
       and chains its install prefix so find_package(nvblox) resolves when the GPU
       backend is compiled. Not a rosdep key: pass "skip-keys nvblox" to rosdep install.
       Ignored for ordering on CPU-only hosts where src/nvblox is not imported. -->
  <depend>nvblox</depend>
  <depend>meridian_common</depend>
  <depend>meridian_config</depend>
  <depend>meridian_debug</depend>
  <depend>meridian_calib</depend>
  <!-- Sophus is provided by the dev image and found via find_package(Sophus); it has no
       standard rosdep key, so it is not listed here. -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
