<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_config</name>
  <version>0.0.0</version>
  <description>Typed Config tree and YAML loader for the Meridian pipeline. Parses the
    master configuration document into meridian::Config and validates units, ranges,
    and cross-field consistency. No ROS.</description>
  <maintainer email="charles@cfglobal.fr">Charles Farhat</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meridian_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>meridian_common</depend>
  <!-- Sophus is provided by the dev image (docker/install-deps.sh) and found via
       find_package(Sophus); it has no standard rosdep key, so it is not listed here. -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
