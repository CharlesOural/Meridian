<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_pipeline</name>
  <version>0.0.0</version>
  <description>Owns and wires the processing stages: sensor sources, the bounded
    sensor queue, the L0/L1 stage (validity filter, IMU init, GNSS gate, aggregation,
    cold-start deskew), and the telemetry sink. The only package that names concrete
    module factories. No ROS.</description>
  <maintainer email="charles@cfglobal.fr">Charles Farhat</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meridian_cmake</buildtool_depend>

  <depend>meridian_common</depend>
  <depend>meridian_config</depend>
  <depend>meridian_time</depend>
  <depend>meridian_debug</depend>
  <depend>meridian_calib</depend>
  <depend>meridian_sensors</depend>
  <depend>meridian_preprocess</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
