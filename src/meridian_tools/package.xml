<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_tools</name>
  <version>0.1.0</version>
  <description>Deterministic ROS 2 bag-to-domain replay tools for Meridian.</description>
  <maintainer email="charles@cfglobal.fr">Charles Farhat</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>meridian_cmake</build_depend>
  <depend>meridian_core</depend>
  <depend>meridian_ros</depend>
  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
