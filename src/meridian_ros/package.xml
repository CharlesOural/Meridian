<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_ros</name>
  <version>0.0.0</version>
  <description>Thin ROS 2 wrapper: the odometry node executable, the msg-to-core
    conversion layer, and the ROS telemetry sink. The only package (besides
    meridian_msgs) allowed to depend on rclcpp.</description>
  <maintainer email="charles@cfglobal.fr">Charles Farhat</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meridian_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>meridian_msgs</depend>
  <depend>meridian_pipeline</depend>
  <depend>meridian_common</depend>
  <depend>meridian_config</depend>
  <depend>meridian_debug</depend>
  <depend>meridian_sensors</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
