Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: CloudRegistered
      Topic:
        Value: /meridian/cloud_registered
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color Transformer: Intensity
      Channel Name: intensity
      Size (m): 0.03
      Style: Points
      Use rainbow: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: DeskewedBodyScan
      Topic:
        Value: /meridian/cloud_body
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color Transformer: Intensity
      Channel Name: intensity
      Size (m): 0.03
      Style: Points
      Use rainbow: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Path
      Topic:
        Value: /meridian/path
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Line Style: Lines
      Color: 255; 255; 255
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: AssocOutliers
      Topic:
        Value: /meridian/cloud_outliers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Size (m): 0.05
      Style: Points
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MeridianMarkers
      Topic:
        Value: /meridian/markers
        Depth: 5
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: CameraIntensity
      Topic:
        Value: /meridian/image/preprocess_camera_intensity
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Name: Current View
      Pitch: 0.6
      Yaw: 0.78
Window Geometry:
  Height: 900
  Width: 1400
