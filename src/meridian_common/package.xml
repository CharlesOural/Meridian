<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_common</name>
  <version>0.0.0</version>
  <description>Cross-cutting value types and math primitives (Pose, NavState,
    KeyframePacket, GaussianBlock, sensor samples, ...) shared by every Meridian layer.
    Header-only; depends only on Eigen and Sophus. No ROS.</description>
  <maintainer email="charles@cfglobal.fr">Charles Farhat</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meridian_cmake</buildtool_depend>

  <depend>eigen</depend>
  <!-- Sophus is provided by the dev image (docker/install-deps.sh) and found via
       find_package(Sophus); it has no standard rosdep key, so it is not listed here. -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
