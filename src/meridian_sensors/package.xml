<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_sensors</name>
  <version>0.0.0</version>
  <description>L0 sensor layer: the ISensorSource interface, the live LiDAR/IMU/camera/GNSS
    sources that stamp wire-free POD frames onto the single Meridian timeline, the
    sensor-health channel, and the per-sweep MeasureGroup aggregator. The core stays
    ROS-free; the ROS wrapper feeds the sources POD frames. No ROS.</description>
  <maintainer email="charles@cfglobal.fr">Charles Farhat</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meridian_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>meridian_common</depend>
  <depend>meridian_time</depend>
  <depend>meridian_debug</depend>
  <depend>meridian_config</depend>
  <!-- Sophus is provided by the dev image (docker/install-deps.sh) and found via
       find_package(Sophus); it has no standard rosdep key, so it is not listed here. -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
