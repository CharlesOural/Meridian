<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meridian_msgs</name>
  <version>0.0.0</version>
  <description>ROS 2 message and service definitions for Meridian's debug/telemetry
    surface (Telemetry, StageTiming, Event, DebugControl services). One of the two
    packages allowed to be ROS-dependent.</description>
  <maintainer email="charles@cfglobal.fr">Charles Farhat</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
